def node_require(script)
  require Pod::Executable.execute_command(
    'node',
    [
      '-p',
      "require.resolve(
        '#{script}',
        {paths: [process.argv[1]]},
      )",
      __dir__
    ]
  ).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

# React Native 0.81
platform :ios, '18.0'

prepare_react_native_project!

# Firebase / Swift pods
# Generate module maps for dependencies used by Swift pods
use_modular_headers!

setup_permissions([
  'Camera',
  'FaceID',
  'LocationAccuracy',
  'LocationAlways',
  'LocationWhenInUse',
  'Notifications',
  'PhotoLibrary',
  'PhotoLibraryAddOnly',
])

target 'ToutRoutesApp' do

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|

    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # Force iOS 18.0 for ALL Pods
    installer.pods_project.targets.each do |target|

      target.build_configurations.each do |build_config|

        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '18.0'

        # C/C++ compatibility with Xcode 26
        build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        build_config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'

        # Firebase / modular headers compatibility
        build_config.build_settings['CLANG_WARN_NON_MODULAR_INCLUDE_IN_FRAMEWORK_MODULE'] = 'NO'

      end
    end

    # Additional settings for problematic C/C++ pods
    ['fmt', 'abseil', 'gRPC-C++', 'gRPC-Core'].each do |pod_name|

      target = installer.pods_project.targets.find do |t|
        t.name == pod_name
      end

      next unless target

      target.build_configurations.each do |build_config|

        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '18.0'
        build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        build_config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
        build_config.build_settings['CLANG_WARN_NON_MODULAR_INCLUDE_IN_FRAMEWORK_MODULE'] = 'NO'

      end
    end

  end

end
