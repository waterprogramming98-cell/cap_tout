def node_require(script)
  require Pod::Executable.execute_command(
    'node',
    [
      '-p',
      "require.resolve(
        '#{script}',
        {paths: [process.argv[1]]},
      )",
      __dir__
    ]
  ).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

# ============================================================
# iOS 18
# ============================================================
platform :ios, '18.0'

prepare_react_native_project!

# ============================================================
# Firebase / Swift pods
# ============================================================
use_modular_headers!

# ============================================================
# React Native Permissions
# ============================================================
setup_permissions([
  'Camera',
  'FaceID',
  'LocationAccuracy',
  'LocationAlways',
  'LocationWhenInUse',
  'Notifications',
  'PhotoLibrary',
  'PhotoLibraryAddOnly',
])

# ============================================================
# Main App
# ============================================================
target 'ToutRoutesApp' do

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # ==========================================================
  # Post Install
  # ==========================================================
  post_install do |installer|

    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # ========================================================
    # Force iOS 18 for ALL Pods
    # ========================================================
    installer.pods_project.targets.each do |target|

      target.build_configurations.each do |build_config|

        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '18.0'

        # React Native 0.81 / C++ requirements
        build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
        build_config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'

        # Firebase / modular headers
        build_config.build_settings[
          'CLANG_WARN_NON_MODULAR_INCLUDE_IN_FRAMEWORK_MODULE'
        ] = 'NO'

      end

    end

    # ========================================================
    # Xcode 26.4 + Apple Clang 21 + fmt workaround
    #
    # React Native's bundled fmt 11.x enables consteval.
    # Xcode 26.4 is stricter and causes:
    #
    # call to consteval function ... is not a constant expression
    #
    # Disable FMT_USE_CONSTEVAL in fmt/base.h.
    # ========================================================

    fmt_base = File.join(
      installer.sandbox.root,
      'fmt',
      'include',
      'fmt',
      'base.h'
    )

    if File.exist?(fmt_base)

      content = File.read(fmt_base)

      unless content.include?('Xcode 26.4 fmt consteval workaround')

        patched_content = content.gsub(
          /(#elif defined\(__cpp_consteval\)\n#\s*define FMT_USE_CONSTEVAL)\s+1/,
          "\\1 0"
        )

        if patched_content != content

          File.chmod(0644, fmt_base)

          patched_content = patched_content.sub(
            "#elif defined(__cpp_consteval)",
            "#elif defined(__cpp_consteval)\n" \
            "// Xcode 26.4 fmt consteval workaround"
          )

          File.write(fmt_base, patched_content)

          puts "=================================================="
          puts "Applied Xcode 26.4 fmt consteval workaround"
          puts "fmt/base.h: FMT_USE_CONSTEVAL = 0"
          puts "=================================================="

        else

          puts "=================================================="
          puts "WARNING: fmt/base.h pattern was not found"
          puts "=================================================="

        end

      else

        puts "=================================================="
        puts "fmt consteval workaround already applied"
        puts "=================================================="

      end

    else

      puts "=================================================="
      puts "WARNING: fmt/base.h was not found"
      puts "=================================================="

    end

    # ========================================================
    # Explicit C++20 for React Native C++ Pods
    # ========================================================

    react_native_cpp_pods = [
      'React',
      'React-Core',
      'ReactCommon',
      'React-utils',
      'React-runtimescheduler',
      'React-runtimeexecutor',
      'React-rendererdebug',
      'React-perflogger',
      'React-featureflags',
      'React-debug',
      'React-RCTFabric',
      'React-RCTFBReactNativeSpec',
      'Yoga',
      'hermes-engine',
      'RCT-Folly',
      'boost',
      'fast_float',
      'glog',
      'DoubleConversion',
      'abseil'
    ]

    react_native_cpp_pods.each do |pod_name|

      pod_target = installer.pods_project.targets.find do |target|
        target.name == pod_name
      end

      next unless pod_target

      pod_target.build_configurations.each do |build_config|

        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '18.0'

        build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'

        build_config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'

      end

    end

  end

end
